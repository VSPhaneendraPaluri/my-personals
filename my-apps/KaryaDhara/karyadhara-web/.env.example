# Karyadhara — environment template.
# Copy this file to .env for local development only.
# On Render, set these in the dashboard or render.yaml — never commit a real .env.

# ── Database (Neon) ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string-for-local-dev-only
PORT=3000
NODE_ENV=development

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────
# RP_ID must match the domain your app runs on (no protocol, no port)
RP_ID=localhost
ORIGIN=http://localhost:3000
# For production:
# RP_ID=karyadhara.onrender.com
# ORIGIN=https://karyadhara.onrender.com

# ── Email OTP via Brevo HTTPS API (REQUIRED on Render's free tier) ────────
# Render free web services BLOCK outbound SMTP (ports 25/465/587), so Gmail
# SMTP times out there. Use Brevo's HTTPS API instead (free: 300 emails/day):
# 1. Sign up at brevo.com → SMTP & API → API Keys → create a key
# 2. Senders, Domains & Dedicated IPs → Senders → add + verify your email
# 3. Set both in the Render dashboard (Environment):
BREVO_API_KEY=
MAIL_FROM=you@example.com
# When BREVO_API_KEY is set, the SMTP_* settings below are ignored.

# ── Email OTP fallback (SMTP — works locally / on paid hosts, not Render free) ─
# 1. Enable 2-Step Verification at myaccount.google.com/security
# 2. Search "App Passwords" → create one named "Karyadhara"
# 3. Paste the 16-character password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxxxxxx

# Optional: displayed in email sender name
RP_NAME=Karyadhara

# ── Mobile OTP (SMS Gateway for Android — free, open-source) ───────────────
# NOT CURRENTLY USED: mobile-number sign-up is disabled for now
# (see MOBILE_SIGNUP_ENABLED in lib/identifier.js). Email is the only
# identifier accepted today. These vars are wired up and ready for whenever
# that flag is flipped back on — no other code changes needed at that point.
# Project: https://github.com/capcom6/android-sms-gateway (Apache-2.0 license)
# No paid SMS vendor involved — a spare Android phone + its SIM card sends
# the texts, using whatever SMS allowance your own carrier plan includes
# (commonly free/bundled). The relay in between is a free public service
# that's also open-source and self-hostable if you want zero third parties.
#
# 1. Install the app on an Android 5.0+ phone:
#    https://github.com/capcom6/android-sms-gateway/releases
# 2. In the app: turn on "Cloud Server" mode, tap "Online" — it shows you a
#    username and password for the free public relay (api.sms-gate.app).
# 3. Paste those credentials below.
#
# Prefer full independence from the public relay? The relay server itself is
# open-source too (https://github.com/android-sms-gateway/server) — run it
# yourself ("Private Server" mode in the app) and point SMS_GATEWAY_BASE_URL
# at your own deployment instead of api.sms-gate.app. Or skip the internet
# entirely with "Local Server" mode and point SMS_GATEWAY_BASE_URL at
# http://<phone-local-ip>:8080 when your app server is on the same network.
SMS_GATEWAY_USER=your-sms-gateway-username
SMS_GATEWAY_PASS=your-sms-gateway-password
# SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1   # default; override for Private/Local mode
