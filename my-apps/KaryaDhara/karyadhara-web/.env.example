# Karyadhara — environment template.
# Copy this file to .env for local development only.
# On Render, set these in the dashboard or render.yaml — never commit a real .env.

# ── Database (Neon) ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Session ───────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string-for-local-dev-only
PORT=3000
NODE_ENV=development

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────
# RP_ID must match the domain your app runs on (no protocol, no port)
RP_ID=localhost
ORIGIN=http://localhost:3000
# For production:
# RP_ID=karyadhara.onrender.com
# ORIGIN=https://karyadhara.onrender.com

# ── Email OTP fallback (Gmail App Password) ───────────────────────────────
# 1. Enable 2-Step Verification at myaccount.google.com/security
# 2. Search "App Passwords" → create one named "Karyadhara"
# 3. Paste the 16-character password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxxxxxx

# Optional: displayed in email sender name
RP_NAME=Karyadhara
